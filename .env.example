# ---------------------------------------------------------------------------
# Secrets for the Stream Notifier bot. Copy this file to ".env" and fill it in.
# NEVER commit your real .env file.
# ---------------------------------------------------------------------------

# Required: your Discord bot token (Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# YouTube (optional but recommended): a YouTube Data API v3 key.
# Without it the bot falls back to scraping the channel /live page.
YOUTUBE_API_KEY=

# Twitch (required only if you set twitch_username in config.json):
# Create an application at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Local web panel: Discord application OAuth2 and bot owner's Discord user ID.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OWNER_ID=

# Public HTTPS origin used by the reverse proxy (no trailing slash or path).
PUBLIC_BASE_URL=https://streams.example.com
# Host interface and port exposed for the reverse proxy; keep loopback if local.
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=8765
